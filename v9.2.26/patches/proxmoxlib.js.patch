+        // --- pve-mods (Zitt) ---
+        render_node_temp: function (record) {
+            if (!record || !Ext.isNumeric(record.used) || !Ext.isNumeric(record.total)) {
+                return '-';
+            }
+            let used = parseFloat(record.used);
+            let total = parseFloat(record.total);
+            return used.toFixed(1) + '°C (crit: ' + total.toFixed(1) + '°C)';
+        },
+
+        render_node_fan: function (record) {
+            if (!record || !Ext.isNumeric(record.used)) {
+                return '-';
+            }
+            return parseFloat(record.used).toFixed(0) + ' RPM';
+        },
+
+        render_node_nvme_life: function (record) {
+            if (!record || !Ext.isNumeric(record.used) || !Ext.isNumeric(record.total)) {
+                return '-';
+            }
+            let u = parseFloat(record.used);
+            let t = parseFloat(record.total);
+            let ratio = ((u * 100) / t).toFixed(0);
+            return ratio + '% remaining';
+        },
+        // --- end pve-mods ---
